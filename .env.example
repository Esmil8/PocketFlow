# MongoDB Configuration
MONGO_USER=admin
MONGO_PASSWORD=your_password_here

# Backend Configuration
PORT=4000
NODE_ENV=development

# MongoDB URI (para conexión local sin Docker)
# MONGO_URI=mongodb://127.0.0.1:27017/pocketflow

# MongoDB URI (para conexión con Docker)
MONGO_URI=mongodb://admin:your_password_here@mongodb:27017/pocketflow?authSource=admin